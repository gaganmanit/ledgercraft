{
  "$comment": [
    "Hand-encoded structural description of the GSTR-1 upload JSON written by lib/gst-json.js, compiled on 09-11-2026.",
    "Primary source: GSTN API portal, Returns, 'GSTR1 - Save GSTR1 data' request schema, version v4.1 (published 04-02-2025). Its shapes match the Returns Offline Tool GST3.2.4 output this app writes (doc_issue.doc_det with integer doc_num 1-12, hsn_b2b/hsn_b2c).",
    "https://developer.gst.gov.in/pages/apiportal/data/Returns/GSTR1%20-%20Save%20GSTR1%20data/v4.1/GSTR1%20-%20Save%20GSTR1%20data%20request_schema.json",
    "https://developer.gst.gov.in/pages/apiportal/data/Returns/GSTR1%20-%20Save%20GSTR1%20data/v4.1/request_payload.json",
    "Pre-split Table 12 (hsn.data with rt, val optional and 0): v4.0 of the same API, https://developer.gst.gov.in/pages/apiportal/data/Returns/GSTR1%20-%20Save%20GSTR1%20data/v4.0/GSTR1%20-%20Save%20GSTR1%20data%20request_schema.json",
    "Cross-checked against v5.0 (published 23-02-2026), identical for every section encoded here except: doc_issue becomes doc_det_new with a string doc_num matching ^(1A|[1-9]|1[0-2])$, ntty adds 'R', and at/txpd are restructured. https://developer.gst.gov.in/pages/apiportal/data/Returns/GSTR1%20-%20Save%20GSTR1%20data/v5.0/GSTR1%20-%20Save%20GSTR1%20data%20request_schema.json and .../v5.0/request_payload.json",
    "Older v1.1 consulted for the original hsn.data shape: https://developer.gst.gov.in/pages/apiportal/data/Returns/GSTR1%20-%20Save%20GSTR1%20data/v1.1/GSTR1%20-%20Save%20GSTR1%20data%20request_schema.json",
    "The portal sits behind a bot check; byte-exact copies of the v4.1/v5.0 schema and sample files (SHA-256 recorded there, matching the portal text lengths 206868 and 449086) were read from https://raw.githubusercontent.com/Total-org/total-org/main/src/main/services/gstGolden/schemas/ (sources.json lists the portal URLs).",
    "40% rate in the notified set: 56th GST Council recommendations, effective 22-09-2025, https://gstcouncil.gov.in/sites/default/files/2025-09/press_release_press_information_bureau_0.pdf",
    "Only the add/modify form of each record is described (no flag, chksum, diff_percent, etin, irn or other fields this app never writes); a record with such a field fails as an unknown key where the published schema is closed.",
    "Constraints marked source 'offline-tool' or 'gst-rate-notifications' go beyond the API schema: they encode what the Returns Offline Tool writes or the notified rate list.",
    "This is a structural check against the published specification, not a portal upload or GSTN validation result."
  ],
  "types": {
    "gstin": { "type": "string", "minLength": 15, "maxLength": 15, "pattern": "^[0-9]{2}[a-zA-Z]{5}[0-9]{4}[a-zA-Z][1-9A-Za-z][Zz1-9A-Ja-j][0-9a-zA-Z]$", "source": "definitions.gstin" },
    "ctin": { "type": "string", "minLength": 15, "maxLength": 15, "pattern": "^(?:[0-9]{2}[a-zA-Z]{5}[0-9]{4}[a-zA-Z][1-9A-Za-z][Zz1-9A-Ja-j][0-9a-zA-Z]|[0-9]{4}[A-Z]{3}[0-9]{5}[UO]N[A-Z0-9]|[0-9]{4}[a-zA-Z]{3}[0-9]{5}NR[0-9a-zA-Z]|[0-9]{2}[a-zA-Z]{4}[a-zA-Z0-9][0-9]{4}[a-zA-Z][1-9A-Za-z]D[0-9a-zA-Z])$", "source": "definitions.ctin (anyOf of regular, UN body, non-resident and TDS patterns)" },
    "period": { "type": "string", "minLength": 6, "maxLength": 6, "pattern": "^((0[1-9]|1[012])((19|20)\\d\\d))$", "source": "properties.fp" },
    "version": { "type": "string", "pattern": "^GST[0-9]+(\\.[0-9]+)+$", "source": "offline-tool (API schema: any string)" },
    "hash": { "type": "string", "enum": ["hash"], "source": "offline-tool (API schema: any string)" },
    "turnover": { "type": "number", "decimals": 2, "minimum": 0, "maximum": 999999999999999.99, "source": "properties.gt / cur_gt" },
    "date": { "type": "string", "pattern": "^(0[1-9]|1[0-9]|2[0-8]|29((?=-([0][13-9]|1[0-2])|(?=-(0[1-9]|1[0-2])-([0-9]{2}(0[48]|[13579][26]|[2468][048])|([02468][048]|[13579][26])00))))|30(?=-(0[13-9]|1[0-2]))|31(?=-(0[13578]|1[02])))-(0[1-9]|1[0-2])-[0-9]{4}$", "source": "definitions.nonEmptydate (dd-mm-yyyy with calendar check)" },
    "docNumber": { "type": "string", "minLength": 1, "maxLength": 16, "pattern": "^(?=.{1,16}$)([/\\-0]*[a-zA-Z0-9/\\-]*[a-zA-Z1-9]+[a-zA-Z0-9/\\-]*)$", "source": "definitions.inum" },
    "pos": { "type": "string", "minLength": 2, "maxLength": 2, "pattern": "^(3[0-8]|[12][0-9]|0[1-9]|97)$", "source": "definitions.state_cd" },
    "posForeign": { "type": "string", "minLength": 2, "maxLength": 2, "pattern": "^(3[0-8]|[12][0-9]|0[1-9]|96|97)$", "source": "definitions.state_cd_foreign" },
    "yesNo": { "type": "string", "enum": ["Y", "N"], "source": "definitions.boolean" },
    "invoiceType": { "type": "string", "enum": ["R", "DE", "SEWP", "SEWOP", "CBW"], "source": "inv_typ" },
    "noteType": { "type": "string", "enum": ["C", "D"], "source": "definitions.ntty (v5.0 adds R)" },
    "invoiceValue": { "type": "number", "decimals": 2, "minimum": 0, "maximum": 9999999999999.99, "source": "definitions.totalValue" },
    "amount": { "type": "number", "decimals": 2, "minimum": 0, "maximum": 99999999999.99, "source": "definitions.txval / nonEmptyCost" },
    "signedAmount": { "type": "number", "decimals": 2, "maximum": 99999999999.99, "source": "definitions.txvalue / nonEmptyNil (no minimum: B2CS and Table 8 accept negatives in the schema)" },
    "hsnAmount": { "type": "number", "decimals": 2, "minimum": -9999999999999.99, "maximum": 9999999999999.99, "source": "definitions.hsnamt" },
    "hsnQuantity": { "type": "number", "decimals": 2, "minimum": -999999999999999.99, "maximum": 999999999999999.99, "source": "definitions.hsnqty (multipleOf 0.01)" },
    "rate": { "type": "number", "decimals": 2, "minimum": 0, "maximum": 999.99, "enum": [0, 0.1, 0.25, 1, 1.5, 3, 5, 6, 7.5, 12, 18, 28, 40], "source": "rt: API schema number 0-999.99 multipleOf 0.01; enum from gst-rate-notifications" },
    "itemNumber": { "type": "integer", "minimum": 1, "source": "itms[].num (cdnur publishes minimum 0)" },
    "count": { "type": "integer", "minimum": 0, "maximum": 9999999999, "source": "doc_issue docs counts" },
    "hsnCode": { "type": "string", "minLength": 2, "maxLength": 8, "pattern": "^[0-9]{2,8}$", "source": "hsn_sc" },
    "uqc": { "type": "string", "minLength": 1, "maxLength": 30, "pattern": "^[a-zA-Z]*$", "source": "hsn uqc" },
    "shippingPort": { "type": "string", "minLength": 1, "maxLength": 6, "pattern": "^[a-zA-Z0-9]+$", "source": "definitions.sbpcode" },
    "shippingBill": { "type": "string", "pattern": "^([0-9]{3,7})?$", "maxLength": 7, "source": "sbnum: 3-7 digits or empty" },
    "itemDetail": { "type": "object", "closed": true, "required": ["rt", "txval"],
      "properties": { "rt": "rate", "txval": "amount", "iamt": "amount", "camt": "amount", "samt": "amount", "csamt": "amount" } },
    "itemDetailOpen": { "type": "object", "closed": false, "required": ["rt", "txval"],
      "properties": { "rt": "rate", "txval": "amount", "iamt": "amount", "camt": "amount", "samt": "amount", "csamt": "amount" } },
    "itemDetailIgst": { "type": "object", "closed": true, "required": ["rt", "txval"],
      "properties": { "rt": "rate", "txval": "amount", "iamt": "amount", "csamt": "amount" } },
    "item": { "type": "object", "closed": true, "required": ["num", "itm_det"], "properties": { "num": "itemNumber", "itm_det": "itemDetail" } },
    "itemOpen": { "type": "object", "closed": false, "required": ["num", "itm_det"], "properties": { "num": "itemNumber", "itm_det": "itemDetailOpen" } },
    "itemIgst": { "type": "object", "closed": true, "required": ["num", "itm_det"], "properties": { "num": "itemNumber", "itm_det": "itemDetailIgst" } },
    "itemIgstOpen": { "type": "object", "closed": false, "required": ["num", "itm_det"], "properties": { "num": "itemNumber", "itm_det": { "type": "object", "closed": false, "required": ["rt", "txval"], "properties": { "rt": "rate", "txval": "amount", "iamt": "amount", "csamt": "amount" } } } },
    "exportItem": { "type": "object", "closed": true, "required": ["rt", "txval"], "properties": { "txval": "amount", "rt": "rate", "iamt": "amount", "csamt": "amount" } },
    "hsnRow": { "type": "object", "closed": true, "required": ["hsn_sc", "uqc", "qty", "num", "txval", "rt"],
      "properties": { "num": "itemNumber", "hsn_sc": "hsnCode", "desc": { "type": "string", "maxLength": 30 }, "user_desc": { "type": "string" }, "uqc": "uqc", "qty": "hsnQuantity",
        "rt": "rate", "val": { "type": "number", "minimum": 0, "maximum": 0 }, "txval": "hsnAmount", "iamt": "hsnAmount", "camt": "hsnAmount", "samt": "hsnAmount", "csamt": "hsnAmount" },
      "source": "hsn_b2b/hsn_b2c first anyOf branch (v4.1), hsn.data first branch (v4.0); desc maxLength 30 from the other branches" },
    "advanceRow": { "type": "object", "closed": true, "required": ["sply_ty", "itms", "pos"],
      "properties": { "pos": "pos", "sply_ty": { "type": "string", "enum": ["INTER", "INTRA"] },
        "itms": { "type": "array", "minItems": 1, "items": { "type": "object", "closed": true, "required": ["ad_amt", "rt"],
          "properties": { "rt": "rate", "ad_amt": "signedAmount", "iamt": "signedAmount", "camt": "signedAmount", "samt": "signedAmount", "csamt": "signedAmount" } } } },
      "source": "at (nonEmptyCostAT: +/-99999999999.99)" },
    "advanceAdjustedRow": { "type": "object", "closed": true, "required": ["sply_ty", "itms", "pos"],
      "properties": { "pos": "pos", "sply_ty": { "type": "string", "enum": ["INTER", "INTRA"] },
        "itms": { "type": "array", "minItems": 1, "items": { "type": "object", "closed": true, "required": ["ad_amt", "rt"],
          "properties": { "rt": "rate", "ad_amt": "amount", "iamt": "amount", "camt": "amount", "samt": "amount", "csamt": "amount" } } } },
      "source": "txpd (Offline Tool tab atadj; nonEmptyCost)" }
  },
  "root": {
    "type": "object", "closed": true, "required": ["gstin", "fp"],
    "properties": {
      "gstin": "gstin", "fp": "period", "version": "version", "hash": "hash", "gt": "turnover", "cur_gt": "turnover",
      "b2b": { "type": "array", "items": { "type": "object", "closed": true, "required": ["ctin", "inv"], "properties": { "ctin": "ctin",
        "inv": { "type": "array", "minItems": 1, "items": { "type": "object", "closed": true, "required": ["inum", "idt", "val", "pos", "rchrg", "inv_typ", "itms"],
          "properties": { "inum": "docNumber", "idt": "date", "val": "invoiceValue", "pos": "posForeign", "rchrg": "yesNo", "inv_typ": "invoiceType",
            "itms": { "type": "array", "minItems": 1, "items": "item" } } } } } } },
      "b2ba": { "type": "array", "items": { "type": "object", "closed": true, "required": ["ctin", "inv"], "properties": { "ctin": "ctin",
        "inv": { "type": "array", "minItems": 1, "items": { "type": "object", "closed": true, "required": ["oinum", "oidt", "inum", "idt", "val", "pos", "rchrg", "inv_typ", "itms"],
          "properties": { "oinum": "docNumber", "oidt": "date", "inum": "docNumber", "idt": "date", "val": "invoiceValue", "pos": "posForeign", "rchrg": "yesNo", "inv_typ": "invoiceType",
            "itms": { "type": "array", "minItems": 1, "items": "item" } } } } } } },
      "b2cl": { "type": "array", "items": { "type": "object", "closed": true, "required": ["pos", "inv"], "properties": { "pos": "pos",
        "inv": { "type": "array", "minItems": 1, "items": { "type": "object", "closed": true, "required": ["inum", "idt", "val", "itms"],
          "properties": { "inum": "docNumber", "idt": "date", "val": "invoiceValue", "itms": { "type": "array", "minItems": 1, "items": "itemIgst" } } } } } } },
      "b2cla": { "type": "array", "items": { "type": "object", "closed": true, "required": ["pos", "inv"], "properties": { "pos": "pos",
        "inv": { "type": "array", "minItems": 1, "items": { "type": "object", "closed": true, "required": ["oinum", "oidt", "inum", "idt", "val", "itms"],
          "properties": { "oinum": "docNumber", "oidt": "date", "inum": "docNumber", "idt": "date", "val": "invoiceValue", "itms": { "type": "array", "minItems": 1, "items": "itemIgst" } } } } } } },
      "b2cs": { "type": "array", "items": { "type": "object", "closed": true, "required": ["sply_ty", "pos", "typ", "rt", "txval"],
        "properties": { "sply_ty": { "type": "string", "enum": ["INTER", "INTRA"] }, "pos": "pos", "typ": { "type": "string", "enum": ["OE", "E"] }, "rt": "rate",
          "txval": "signedAmount", "iamt": "signedAmount", "camt": "signedAmount", "samt": "signedAmount", "csamt": "signedAmount" } } },
      "b2csa": { "type": "array", "items": { "type": "object", "closed": true, "required": ["omon", "sply_ty", "pos", "typ"],
        "properties": { "omon": "period", "sply_ty": { "type": "string", "enum": ["INTER", "INTRA"] }, "pos": "pos", "typ": { "type": "string", "enum": ["OE", "E"] },
          "itms": { "type": "array", "minItems": 1, "items": { "type": "object", "closed": true, "required": ["rt", "txval"],
            "properties": { "rt": "rate", "txval": "signedAmount", "iamt": "signedAmount", "camt": "signedAmount", "samt": "signedAmount", "csamt": "signedAmount" } } } } } },
      "cdnr": { "type": "array", "items": { "type": "object", "closed": true, "required": ["ctin", "nt"], "properties": { "ctin": "ctin",
        "nt": { "type": "array", "minItems": 1, "items": { "type": "object", "closed": true, "required": ["ntty", "nt_num", "nt_dt", "val", "pos", "rchrg", "inv_typ", "itms"],
          "properties": { "ntty": "noteType", "nt_num": "docNumber", "nt_dt": "date", "val": "invoiceValue", "pos": "posForeign", "rchrg": "yesNo", "inv_typ": "invoiceType",
            "itms": { "type": "array", "minItems": 1, "items": "itemOpen" } } } } } } },
      "cdnra": { "type": "array", "items": { "type": "object", "closed": true, "required": ["ctin", "nt"], "properties": { "ctin": "ctin",
        "nt": { "type": "array", "minItems": 1, "items": { "type": "object", "closed": true, "required": ["ntty", "ont_num", "ont_dt", "nt_num", "nt_dt", "val", "pos", "rchrg", "inv_typ", "itms"],
          "properties": { "ntty": "noteType", "ont_num": "docNumber", "ont_dt": "date", "nt_num": "docNumber", "nt_dt": "date", "val": "invoiceValue", "pos": "posForeign", "rchrg": "yesNo", "inv_typ": "invoiceType",
            "itms": { "type": "array", "minItems": 1, "items": "itemOpen" } } } } } } },
      "cdnur": { "type": "array", "items": { "type": "object", "closed": true, "required": ["typ", "ntty", "nt_num", "nt_dt", "val", "itms"],
        "properties": { "typ": { "type": "string", "enum": ["B2CL", "EXPWP", "EXPWOP"] }, "ntty": "noteType", "nt_num": "docNumber", "nt_dt": "date", "val": "invoiceValue", "pos": "pos",
          "itms": { "type": "array", "minItems": 1, "items": "itemOpen" } },
        "conditions": [{ "when": { "typ": ["B2CL"] }, "required": ["pos"] }, { "when": { "typ": ["EXPWP", "EXPWOP"] }, "forbidden": ["pos"] }] } },
      "cdnura": { "type": "array", "items": { "type": "object", "closed": true, "required": ["typ", "ntty", "ont_num", "ont_dt", "nt_num", "nt_dt", "val", "itms"],
        "properties": { "typ": { "type": "string", "enum": ["B2CL", "EXPWP", "EXPWOP"] }, "ntty": "noteType", "ont_num": "docNumber", "ont_dt": "date", "nt_num": "docNumber", "nt_dt": "date", "val": "invoiceValue", "pos": "pos",
          "itms": { "type": "array", "minItems": 1, "items": "itemIgstOpen" } },
        "conditions": [{ "when": { "typ": ["B2CL"] }, "required": ["pos"] }, { "when": { "typ": ["EXPWP", "EXPWOP"] }, "forbidden": ["pos"] }] } },
      "exp": { "type": "array", "items": { "type": "object", "closed": true, "required": ["exp_typ", "inv"], "properties": { "exp_typ": { "type": "string", "enum": ["WPAY", "WOPAY"] },
        "inv": { "type": "array", "minItems": 1, "items": { "type": "object", "closed": true, "required": ["inum", "idt", "val", "itms"],
          "properties": { "inum": "docNumber", "idt": "date", "val": "invoiceValue", "sbpcode": "shippingPort", "sbnum": "shippingBill", "sbdt": "date",
            "itms": { "type": "array", "minItems": 1, "items": "exportItem" } } } } } } },
      "expa": { "type": "array", "items": { "type": "object", "closed": true, "required": ["exp_typ", "inv"], "properties": { "exp_typ": { "type": "string", "enum": ["WPAY", "WOPAY"] },
        "inv": { "type": "array", "minItems": 1, "items": { "type": "object", "closed": true, "required": ["oinum", "oidt", "inum", "idt", "val", "itms"],
          "properties": { "oinum": "docNumber", "oidt": "date", "inum": "docNumber", "idt": "date", "val": "invoiceValue", "sbpcode": "shippingPort", "sbnum": "shippingBill", "sbdt": "date",
            "itms": { "type": "array", "minItems": 1, "items": "exportItem" } } } } } } },
      "at": { "type": "array", "items": "advanceRow" },
      "txpd": { "type": "array", "items": "advanceAdjustedRow" },
      "hsn": { "type": "object", "closed": true, "required": [],
        "properties": { "data": { "type": "array", "minItems": 1, "items": "hsnRow" }, "hsn_b2b": { "type": "array", "items": "hsnRow" }, "hsn_b2c": { "type": "array", "items": "hsnRow" } },
        "requireOneGroup": [["data"], ["hsn_b2b", "hsn_b2c"]],
        "source": "v4.1/v5.0: anyOf required hsn_b2b or hsn_b2c; v4.0 and earlier: data. The two layouts never appear together." },
      "nil": { "type": "object", "closed": true, "required": ["inv"],
        "properties": { "inv": { "type": "array", "minItems": 1, "items": { "type": "object", "closed": true, "required": ["sply_ty", "nil_amt", "expt_amt", "ngsup_amt"],
          "properties": { "sply_ty": { "type": "string", "enum": ["INTRB2B", "INTRB2C", "INTRAB2B", "INTRAB2C"] }, "nil_amt": "signedAmount", "expt_amt": "signedAmount", "ngsup_amt": "signedAmount" } } } } },
      "doc_issue": { "type": "object", "closed": true, "required": ["doc_det"],
        "properties": { "doc_det": { "type": "array", "items": { "type": "object", "closed": true, "required": ["doc_num", "docs"],
          "properties": { "doc_num": { "type": "integer", "minimum": 1, "maximum": 12 }, "doc_typ": { "type": "string", "minLength": 1 },
            "docs": { "type": "array", "items": { "type": "object", "closed": true, "required": ["num", "from", "to", "totnum", "cancel", "net_issue"],
              "properties": { "num": "itemNumber", "from": "docNumber", "to": "docNumber", "totnum": "count", "cancel": "count", "net_issue": "count" } } } } } } } }
    }
  }
