<!-- Synthetic data in the layout of a TallyPrime "All Masters" XML (Data Interchange) export: one object per
     TALLYMESSAGE, RESERVEDNAME/GUID/ALTERID noise, empty .LIST collections, Tally's \u0004 "Not Applicable" markers,
     leading spaces in quantities and Tally's sign rule for stock values (a normal debit opening value is negative,
     exactly as Tally's own integration sample writes "-1 * qty * rate"). No private company data. -->
<ENVELOPE>
 <HEADER>
  <TALLYREQUEST>Import Data</TALLYREQUEST>
 </HEADER>
 <BODY>
  <IMPORTDATA>
   <REQUESTDESC>
    <REPORTNAME>All Masters</REPORTNAME>
    <STATICVARIABLES>
     <SVCURRENTCOMPANY>Synthetic Prime Traders</SVCURRENTCOMPANY>
    </STATICVARIABLES>
   </REQUESTDESC>
   <REQUESTDATA>
    <TALLYMESSAGE xmlns:UDF="TallyUDF">
     <UNIT NAME="nos" RESERVEDNAME="">
      <NAME>nos</NAME>
      <GUID>synthetic-prime-unit-nos</GUID>
      <ORIGINALNAME>Numbers</ORIGINALNAME>
      <GSTREPUOM>NOS-NUMBERS</GSTREPUOM>
      <ISUPDATINGTARGETID>No</ISUPDATINGTARGETID>
      <ASORIGINAL>Yes</ASORIGINAL>
      <ISGSTEXCLUDED>No</ISGSTEXCLUDED>
      <ISSIMPLEUNIT>Yes</ISSIMPLEUNIT>
      <ALTERID> 11</ALTERID>
      <DECIMALPLACES> 0</DECIMALPLACES>
     </UNIT>
    </TALLYMESSAGE>
    <TALLYMESSAGE xmlns:UDF="TallyUDF">
     <GODOWN NAME="Workshop" RESERVEDNAME="">
      <GUID>synthetic-prime-godown-workshop</GUID>
      <PARENT/>
      <JOBNAME/>
      <ISUPDATINGTARGETID>No</ISUPDATINGTARGETID>
      <ASORIGINAL>Yes</ASORIGINAL>
      <HASNOSPACE>No</HASNOSPACE>
      <ISINTERNAL>No</ISINTERNAL>
      <ISEXTERNAL>No</ISEXTERNAL>
      <ALTERID> 12</ALTERID>
      <LANGUAGENAME.LIST>
       <NAME.LIST TYPE="String">
        <NAME>Workshop</NAME>
       </NAME.LIST>
       <LANGUAGEID> 1033</LANGUAGEID>
      </LANGUAGENAME.LIST>
     </GODOWN>
    </TALLYMESSAGE>
    <TALLYMESSAGE xmlns:UDF="TallyUDF">
     <LEDGER NAME="Cash" RESERVEDNAME="">
      <GUID>synthetic-prime-ledger-cash</GUID>
      <PARENT>Cash-in-Hand</PARENT>
      <OPENINGBALANCE>-1000.00</OPENINGBALANCE>
     </LEDGER>
    </TALLYMESSAGE>
    <TALLYMESSAGE xmlns:UDF="TallyUDF">
     <LEDGER NAME="Capital" RESERVEDNAME="">
      <GUID>synthetic-prime-ledger-capital</GUID>
      <PARENT>Capital Account</PARENT>
      <OPENINGBALANCE>1000.00</OPENINGBALANCE>
     </LEDGER>
    </TALLYMESSAGE>
    <TALLYMESSAGE xmlns:UDF="TallyUDF">
     <LEDGER NAME="Sales" RESERVEDNAME="">
      <GUID>synthetic-prime-ledger-sales</GUID>
      <PARENT>Sales Accounts</PARENT>
     </LEDGER>
    </TALLYMESSAGE>
    <TALLYMESSAGE xmlns:UDF="TallyUDF">
     <LEDGER NAME="Purchases" RESERVEDNAME="">
      <GUID>synthetic-prime-ledger-purchases</GUID>
      <PARENT>Purchase Accounts</PARENT>
     </LEDGER>
    </TALLYMESSAGE>
    <TALLYMESSAGE xmlns:UDF="TallyUDF">
     <STOCKITEM NAME="Synthetic Widget" RESERVEDNAME="">
      <OLDAUDITENTRYIDS.LIST TYPE="Number">
       <OLDAUDITENTRYIDS>-1</OLDAUDITENTRYIDS>
      </OLDAUDITENTRYIDS.LIST>
      <GUID>synthetic-prime-stockitem-widget</GUID>
      <PARENT>&#4; Primary</PARENT>
      <CATEGORY>&#4; Not Applicable</CATEGORY>
      <GSTAPPLICABLE>&#4; Applicable</GSTAPPLICABLE>
      <TAXCLASSIFICATIONNAME>&#4; Not Applicable</TAXCLASSIFICATIONNAME>
      <GSTTYPEOFSUPPLY>Goods</GSTTYPEOFSUPPLY>
      <COSTINGMETHOD>FIFO Perpetual</COSTINGMETHOD>
      <VALUATIONMETHOD>Avg. Price</VALUATIONMETHOD>
      <BASEUNITS>nos</BASEUNITS>
      <ADDITIONALUNITS>&#4; Not Applicable</ADDITIONALUNITS>
      <ISCOSTCENTRESON>No</ISCOSTCENTRESON>
      <ISBATCHWISEON>No</ISBATCHWISEON>
      <ISPERISHABLEON>No</ISPERISHABLEON>
      <ISENTRYTAXAPPLICABLE>No</ISENTRYTAXAPPLICABLE>
      <ISCOSTTRACKINGON>No</ISCOSTTRACKINGON>
      <ISUPDATINGTARGETID>No</ISUPDATINGTARGETID>
      <ASORIGINAL>Yes</ASORIGINAL>
      <IGNOREPHYSICALDIFFERENCE>No</IGNOREPHYSICALDIFFERENCE>
      <IGNORENEGATIVESTOCK>No</IGNORENEGATIVESTOCK>
      <TREATSALESASMANUFACTURED>No</TREATSALESASMANUFACTURED>
      <TREATPURCHASESASCONSUMED>No</TREATPURCHASESASCONSUMED>
      <TREATREJECTSASSCRAP>No</TREATREJECTSASSCRAP>
      <HASMFGDATE>No</HASMFGDATE>
      <ALLOWUSEOFEXPIREDITEMS>No</ALLOWUSEOFEXPIREDITEMS>
      <IGNOREBATCHES>No</IGNOREBATCHES>
      <IGNOREGODOWNS>No</IGNOREGODOWNS>
      <ALTERID> 31</ALTERID>
      <DENOMINATOR> 1</DENOMINATOR>
      <OPENINGBALANCE> 10 nos</OPENINGBALANCE>
      <OPENINGVALUE>-1000.00</OPENINGVALUE>
      <OPENINGRATE>100.00/nos</OPENINGRATE>
      <SERVICETAXDETAILS.LIST>      </SERVICETAXDETAILS.LIST>
      <VATDETAILS.LIST>      </VATDETAILS.LIST>
      <SALESTAXCESSDETAILS.LIST>      </SALESTAXCESSDETAILS.LIST>
      <GSTDETAILS.LIST>      </GSTDETAILS.LIST>
      <LANGUAGENAME.LIST>
       <NAME.LIST TYPE="String">
        <NAME>Synthetic Widget</NAME>
       </NAME.LIST>
       <LANGUAGEID> 1033</LANGUAGEID>
      </LANGUAGENAME.LIST>
      <BATCHALLOCATIONS.LIST>
       <GODOWNNAME>Main Location</GODOWNNAME>
       <BATCHNAME>Primary Batch</BATCHNAME>
       <MFDON>20260401</MFDON>
       <OPENINGBALANCE> 6 nos</OPENINGBALANCE>
       <OPENINGVALUE>-600.00</OPENINGVALUE>
       <OPENINGRATE>100.00/nos</OPENINGRATE>
      </BATCHALLOCATIONS.LIST>
      <BATCHALLOCATIONS.LIST>
       <GODOWNNAME>Workshop</GODOWNNAME>
       <BATCHNAME>Primary Batch</BATCHNAME>
       <MFDON>20260401</MFDON>
       <OPENINGBALANCE> 4 nos</OPENINGBALANCE>
       <OPENINGVALUE>-400.00</OPENINGVALUE>
       <OPENINGRATE>100.00/nos</OPENINGRATE>
      </BATCHALLOCATIONS.LIST>
      <TRADINGITEMLIST.LIST>      </TRADINGITEMLIST.LIST>
      <REORDERLIST.LIST>      </REORDERLIST.LIST>
     </STOCKITEM>
    </TALLYMESSAGE>
   </REQUESTDATA>
  </IMPORTDATA>
 </BODY>
</ENVELOPE>
